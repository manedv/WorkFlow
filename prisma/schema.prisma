generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  avatar       String?
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  organizationMemberships OrganizationMember[]
  projectMemberships      ProjectMember[]
  ledProjects             Project[]            @relation("ProjectLead")
  reportedIssues          Issue[]              @relation("IssueReporter")
  assignedIssues          Issue[]              @relation("IssueAssignee")
  activities              Activity[]
  comments                Comment[]
  notifications           Notification[]

  @@index([email])
  @@map("users")
}

model Organization {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members  OrganizationMember[]
  projects Project[]

  @@map("organizations")
}

model OrganizationMember {
  id             String   @id @default(cuid())
  organizationId String
  userId         String
  role           String   @default("MEMBER")
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@index([organizationId])
  @@index([userId])
  @@map("organization_members")
}

model Project {
  id             String   @id @default(cuid())
  name           String
  key            String
  description    String?
  organizationId String
  leadId         String?
  avatar         String?
  isArchived     Boolean  @default(false)
  issueCounter   Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  lead         User?           @relation("ProjectLead", fields: [leadId], references: [id], onDelete: SetNull)
  members      ProjectMember[]
  statuses     Status[]
  issues       Issue[]
  sprints      Sprint[]

  @@unique([organizationId, key])
  @@index([organizationId])
  @@index([leadId])
  @@map("projects")
}

model ProjectMember {
  id        String   @id @default(cuid())
  projectId String
  userId    String
  role      String   @default("MEMBER")
  createdAt DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId])
  @@index([projectId])
  @@index([userId])
  @@map("project_members")
}

model Status {
  id        String @id @default(cuid())
  name      String
  slug      String
  position  Int
  projectId String

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  issues  Issue[]

  @@unique([projectId, slug])
  @@index([projectId])
  @@map("statuses")
}

model Issue {
  id            String   @id @default(cuid())
  issueKey      String   @unique
  issueNumber   Int
  projectId     String
  type          String   @default("TASK")
  summary       String
  description   String?
  statusId      String
  priority      String   @default("MEDIUM")
  reporterId    String
  assigneeId    String?
  parentIssueId String?
  sprintId      String?
  storyPoints   Int?
  position      Int      @default(0)
  dueDate       DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  project     Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  status      Status       @relation(fields: [statusId], references: [id])
  reporter    User         @relation("IssueReporter", fields: [reporterId], references: [id])
  assignee    User?        @relation("IssueAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  parentIssue Issue?       @relation("SubIssues", fields: [parentIssueId], references: [id], onDelete: SetNull)
  subIssues   Issue[]      @relation("SubIssues")
  sprint      Sprint?      @relation(fields: [sprintId], references: [id], onDelete: SetNull)
  activities  Activity[]
  comments    Comment[]
  attachments Attachment[]

  @@unique([projectId, issueNumber])
  @@index([projectId])
  @@index([statusId])
  @@index([assigneeId])
  @@index([reporterId])
  @@index([parentIssueId])
  @@index([sprintId])
  @@map("issues")
}

model Activity {
  id        String   @id @default(cuid())
  issueId   String
  userId    String
  action    String
  field     String?
  oldValue  String?
  newValue  String?
  createdAt DateTime @default(now())

  issue Issue @relation(fields: [issueId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id])

  @@index([issueId])
  @@index([userId])
  @@map("activities")
}

model Sprint {
  id        String   @id @default(cuid())
  name      String
  goal      String?
  projectId String
  status    String   @default("PLANNING")
  startDate DateTime?
  endDate   DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  issues  Issue[]

  @@index([projectId])
  @@map("sprints")
}

model Comment {
  id        String   @id @default(cuid())
  content   String
  issueId   String
  authorId  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  issue  Issue @relation(fields: [issueId], references: [id], onDelete: Cascade)
  author User  @relation(fields: [authorId], references: [id])

  @@index([issueId])
  @@index([authorId])
  @@map("comments")
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  type      String
  title     String
  message   String
  issueId   String?
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@index([userId])
  @@map("notifications")
}

model Attachment {
  id           String   @id @default(cuid())
  issueId      String
  filename     String
  originalName String
  mimeType     String
  size         Int
  uploadedById String
  createdAt    DateTime @default(now())

  issue Issue @relation(fields: [issueId], references: [id], onDelete: Cascade)

  @@index([issueId])
  @@map("attachments")
}
